# Vichith website / AI Runtime — required server environment.
# Copy to .env.local for development. Secrets have NO defaults: a missing value
# fails the request with a clear error rather than falling through (src/lib/env.ts).

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Desktop session tokens. REQUIRED — there is deliberately no fallback secret.
JWT_SECRET=

# Internal admin console (/admin)
ADMIN_PASSCODE=

# AI Runtime providers. SERVER-SIDE ONLY — these must never reach the desktop or
# a browser client. The desktop talks only to /api/ai.
GEMINI_API_KEY=
SARVAM_API_KEY=

# Optional: endpoint smoke tests
# TEST_BASE_URL=http://localhost:3000
